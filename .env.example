# Current Cloudflare Pages URL. After connecting mogu24.jp, set this to https://mogu24.jp in Cloudflare Pages environment variables.
# robots.txt, sitemap.xml, canonical URLs, hreflang and structured data will then use the production domain on the next build.
NEXT_PUBLIC_SITE_URL=https://mogu24-website.pages.dev

# Optional: paste the Google Search Console HTML-tag verification value here (content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
